<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Заголовок: значок камеры + заголовок -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_camera"
                android:tint="@color/accent"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/connect_title"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Подсказка -->
        <TextView
            android:id="@+id/hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/connect_hint"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Поиск камеры -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_search"
                        android:textColor="@color/text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/scanState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/connect_search_waiting"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnScan"
                    style="@style/RoundButton.Big"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_wifi"
                    android:tint="@color/accent"
                    android:text="@null"
                    android:textColor="@null"
                    android:elevation="2dp"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

            <!-- Список найденных камер -->
            <LinearLayout
                android:id="@+id/networkList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- Подключение -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_connect_title"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Выбранная сеть -->
            <LinearLayout
                style="@style/SwitchRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/connect_network" />

                    <TextView
                        android:id="@+id/networkLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:text="@string/connect_no_network" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/networkIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_wifi_off"
                    android:tint="@color/text_dim"
                    android:contentDescription="@null" />

            </LinearLayout>

            <!-- Пароль -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    style="@style/FieldLabel"
                    android:text="@string/connect_password" />

                <EditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:imeOptions="actionDone"
                    android:background="@drawable/bg_field"
                    android:padding="12dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text_dim"
                    android:textSize="15sp"
                    android:hint="@string/connect_password_hint" />

            </LinearLayout>

            <!-- Кнопка подключения -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/connect_connect"
                android:textColor="@color/background"
                android:textSize="15sp"
                android:background="@drawable/bg_round_accent"
                android:elevation="2dp" />

            <!-- Состояние подключения -->
            <TextView
                android:id="@+id/connectState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Кнопка «Забыть» -->
        <Button
            android:id="@+id/btnForget"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/connect_forget"
            android:textColor="@color/warn"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        <!-- Нижняя навигация -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_flat">

            <Button
                android:id="@+id/bottomPano"
                style="@style/BottomButton"
                android:src="@drawable/ic_pano"
                android:contentDescription="@string/nav_pano"
                android:visibility="gone" />

            <Button
                android:id="@+id/bottomCamera"
                style="@style/BottomButton"
                android:src="@drawable/ic_camera"
                android:contentDescription="@string/nav_camera"
                android:visibility="gone" />

            <Button
                android:id="@+id/bottomGallery"
                style="@style/BottomButton"
                android:src="@drawable/ic_gallery"
                android:contentDescription="@string/nav_gallery"
                android:visibility="gone" />

            <Button
                android:id="@+id/bottomSettings"
                style="@style/BottomButton"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/nav_settings" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
