<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pl_background"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Прямой эфир по TCP-потоку (декодирование MediaCodec), резервный канал при недоступности OSC-MJPEG.
             Нижняя вёрстка: UI-элементы (статус, прогресс, кнопки) лежат поверх. -->
        <SurfaceView
            android:id="@+id/preview_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/pl_surface"
            android:contentDescription="@string/main_gimbal"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/preview_off"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/main_preview_off"
            android:textColor="?attr/pl_text_dim"
            android:textSize="14sp" />

        <!-- Верхняя строка состояния -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/status_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/pl_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="?attr/pl_text"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btn_connect"
                style="@style/RoundButton.Small"
                android:contentDescription="@string/main_connect"
                android:src="@drawable/ic_link" />
        </LinearLayout>

        <!-- Прогресс панорамы -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="72dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/pano_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:max="100"
                android:progress="0"
                android:progressTint="?attr/pl_accent" />

            <TextView
                android:id="@+id/pano_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="?attr/pl_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Кнопки управления панорамой (пиктограммы) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_start"
                style="@style/RoundButton.Accent"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/main_pano_start"
                android:src="@drawable/ic_shutter" />

            <ImageButton
                android:id="@+id/btn_pause"
                style="@style/RoundButton"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/main_pano_pause"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/btn_resume"
                style="@style/RoundButton"
                android:layout_marginEnd="14dp"
                android:contentDescription="@string/main_pano_resume"
                android:src="@drawable/ic_play" />

            <ImageButton
                android:id="@+id/btn_stop"
                style="@style/RoundButton"
                android:contentDescription="@string/main_pano_stop"
                android:src="@drawable/ic_stop" />
        </LinearLayout>

        <!-- Журнал скрыт по умолчанию: он занимал полосу над кнопками и мешал
             смотреть превью. Открывается кнопкой-листом в нижней панели, там же
             долгое нажатие по-прежнему копирует/сохраняет весь лог. -->
        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="72dp"
            android:background="?attr/pl_surface"
            android:maxHeight="160dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/pl_text_dim"
                android:textSize="11sp" />
        </ScrollView>
    </FrameLayout>

    <!-- Нижняя панель: шестерёнка настроек по центру.
         Раньше кнопка растягивалась на всю ширину (BottomButton = weight 1),
         из-за чего выглядела полосой, а не шестерёнкой. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_log"
            style="@style/RoundButton"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/main_log"
            android:src="@drawable/ic_log" />

        <ImageButton
            android:id="@+id/btn_app_settings"
            style="@style/RoundButton"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/main_app_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

</LinearLayout>
