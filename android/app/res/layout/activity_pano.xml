<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pano_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pano_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pano_plan_24"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/preset_24"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="24"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/preset_18"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="18"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/preset_12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="12"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/preset_36"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="36"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                style="@style/FieldLabel"
                android:layout_gravity="center_vertical"
                android:text="@string/pano_rows" />

            <EditText
                android:id="@+id/pano_rows"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_gravity="center_vertical"
                android:text="@string/pano_columns" />

            <EditText
                android:id="@+id/pano_columns"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                style="@style/FieldLabel"
                android:layout_gravity="center_vertical"
                android:text="@string/pano_overlap" />

            <EditText
                android:id="@+id/pano_overlap"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_gravity="center_vertical"
                android:text="@string/pano_delay" />

            <EditText
                android:id="@+id/pano_delay"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                style="@style/FieldLabel"
                android:layout_gravity="center_vertical"
                android:text="@string/pano_tilt_bottom" />

            <EditText
                android:id="@+id/pano_tilt_bottom"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberSigned"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_gravity="center_vertical"
                android:text="@string/pano_tilt_top" />

            <EditText
                android:id="@+id/pano_tilt_top"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="numberSigned"
                android:textColor="@color/text" />
        </LinearLayout>

        <Button
            android:id="@+id/pano_start"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_round_accent"
            android:text="@string/pano_start"
            android:textColor="@color/background"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pano_download"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round"
            android:text="@string/pano_download"
            android:textColor="@color/text" />

        <ProgressBar
            android:id="@+id/pano_download_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/pano_export"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round"
            android:text="@string/pano_export"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/pano_export_csv"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round"
            android:text="@string/pano_export_csv"
            android:textColor="@color/text" />

        <Button
            android:id="@+id/pano_export_job"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_round_accent"
            android:text="@string/pano_export_job"
            android:textColor="@color/background"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
