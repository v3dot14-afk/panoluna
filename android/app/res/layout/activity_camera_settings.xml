<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cam_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/cam_photo_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/size_standard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="12 MP"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/size_ultra"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="48 MP"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/cam_zoom" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/zoom_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="1x"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/zoom_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="2x"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/zoom_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="3x"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/zoom_6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="6x"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/zoom_12"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="12x"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/cam_mode" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/mode_auto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round_accent"
                    android:text="@string/cam_auto"
                    android:textColor="@color/background" />

                <Button
                    android:id="@+id/mode_pro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="@string/cam_pro"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="14dp"
                android:text="@string/cam_iso" />

            <EditText
                android:id="@+id/cam_iso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 = automatico"
                android:inputType="number"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/cam_shutter" />

            <EditText
                android:id="@+id/cam_shutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 = automatico, altrimenti microsecondi"
                android:inputType="number"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/cam_ev" />

            <EditText
                android:id="@+id/cam_ev"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="terzi di stop, -6..+6"
                android:inputType="numberSigned"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/cam_wb" />

            <EditText
                android:id="@+id/cam_wb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 = automatico, altrimenti Kelvin"
                android:inputType="number"
                android:textColor="@color/text" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/cam_brightness" />

            <EditText
                android:id="@+id/cam_brightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="-2..+2"
                android:inputType="numberSigned"
                android:textColor="@color/text" />

            <CheckBox
                android:id="@+id/cam_raw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/cam_raw"
                android:textColor="@color/text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                style="@style/FieldLabel"
                android:text="@string/cam_gimbal_speed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/gspeed_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="Lento"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/gspeed_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="Medio"
                    android:textColor="@color/text" />

                <Button
                    android:id="@+id/gspeed_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_round"
                    android:text="Veloce"
                    android:textColor="@color/text" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/cam_apply"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_round_accent"
            android:text="@string/cam_apply"
            android:textColor="@color/background"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
