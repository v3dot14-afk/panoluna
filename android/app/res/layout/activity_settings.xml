<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_title"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Внешний вид -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/FieldLabelCompact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_theme_dark" />

        <Switch
            android:id="@+id/set_dark_theme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1.05"
            android:scaleY="1.05"
            android:thumbTint="@color/accent"
            android:trackTint="@color/surface_high"
            android:switchMinWidth="50dp" />
    </LinearLayout>

    <!-- Камера -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/GroupTitle"
            android:layout_marginBottom="6dp"
            android:text="@string/settings_camera" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_host" />

            <EditText
                android:id="@+id/set_host"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_port" />

            <EditText
                android:id="@+id/set_port"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_timeout" />

            <EditText
                android:id="@+id/set_timeout"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

    <!-- Гимбал -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/GroupTitle"
            android:layout_marginBottom="6dp"
            android:text="@string/settings_gimbal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_pan_limits" />

            <EditText
                android:id="@+id/set_pan_min"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:inputType="numberSigned" />

            <EditText
                android:id="@+id/set_pan_max"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:inputType="numberSigned" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_tilt_limits" />

            <EditText
                android:id="@+id/set_tilt_min"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:inputType="numberSigned" />

            <EditText
                android:id="@+id/set_tilt_max"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:inputType="numberSigned" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_angular_scale" />

            <EditText
                android:id="@+id/set_scale"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="numberDecimal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Данные -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/FieldLabelCompact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_data" />

        <Button
            android:id="@+id/set_clear"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/settings_clear_action"
            android:textColor="@color/warn"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/set_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_dim"
        android:textSize="11sp" />

</LinearLayout>
