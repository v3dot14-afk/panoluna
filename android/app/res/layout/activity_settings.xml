<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Внешний вид: переключение темы -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_appearance"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/SwitchRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SwitchLabel"
                        android:text="@string/settings_theme_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_theme_desc"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                </LinearLayout>

                <Switch
                    android:id="@+id/set_dark_theme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleX="1.05"
                    android:scaleY="1.05"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/surface_high"
                    android:switchMinWidth="52dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Камера -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/settings_host" />

            <EditText
                android:id="@+id/set_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:inputType="text"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/settings_port" />

            <EditText
                android:id="@+id/set_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:inputType="number"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/settings_timeout" />

            <EditText
                android:id="@+id/set_timeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:inputType="number"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Wi-Fi -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_wifi"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/set_wifi_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <Button
                android:id="@+id/set_wifi_forget"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_round"
                android:text="@string/settings_wifi_forget"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- Gimbal -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_gimbal"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_gravity="center_vertical"
                    android:text="@string/settings_pan_limits" />

                <EditText
                    android:id="@+id/set_pan_min"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:padding="8dp"
                    android:inputType="numberSigned"
                    android:textColor="@color/text" />

                <EditText
                    android:id="@+id/set_pan_max"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_field"
                    android:padding="8dp"
                    android:inputType="numberSigned"
                    android:textColor="@color/text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_gravity="center_vertical"
                    android:text="@string/settings_tilt_limits" />

                <EditText
                    android:id="@+id/set_tilt_min"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_field"
                    android:padding="8dp"
                    android:inputType="numberSigned"
                    android:textColor="@color/text" />

                <EditText
                    android:id="@+id/set_tilt_max"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_field"
                    android:padding="8dp"
                    android:inputType="numberSigned"
                    android:textColor="@color/text" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="10dp"
                android:text="@string/settings_angular_scale" />

            <EditText
                android:id="@+id/set_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:inputType="numberDecimal"
                android:textColor="@color/text"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/set_invert_pan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_invert_pan"
                android:textColor="@color/text" />

            <CheckBox
                android:id="@+id/set_invert_tilt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_invert_tilt"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- Данные -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_data"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/set_clear"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_round"
                android:text="@string/settings_clear"
                android:textColor="@color/warn" />
        </LinearLayout>

        <!-- Темпляты -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_templates"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_templates_info"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- О приложении -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_about"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/set_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
