<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/pl_background"
    android:fillViewport="true"
    android:clipToPadding="false">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/settings_title"
        android:textColor="?attr/pl_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Внешний вид -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/FieldLabelCompact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_theme_dark" />

        <!-- Три варианта вместо тумблера: системная тема нужна, когда телефон сам
             переключается по расписанию, принудительная — когда нужно всегда. -->
        <Spinner
            android:id="@+id/set_theme_mode"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <!-- Язык интерфейса: приложение не меняет язык телефона, только свои строки. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/FieldLabelCompact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_language" />

        <Spinner
            android:id="@+id/set_language"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

    </LinearLayout>

    <!-- Камера -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/GroupTitle"
            android:layout_marginBottom="6dp"
            android:text="@string/settings_camera" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_host" />

            <EditText
                android:id="@+id/set_host"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_port" />

            <EditText
                android:id="@+id/set_port"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_timeout" />

            <EditText
                android:id="@+id/set_timeout"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="number" />
        </LinearLayout>
    </LinearLayout>

    <!-- Гимбал -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            style="@style/GroupTitle"
            android:layout_marginBottom="6dp"
            android:text="@string/settings_gimbal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_pan_limits" />

            <EditText
                android:id="@+id/set_pan_min"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:inputType="numberSigned" />

            <EditText
                android:id="@+id/set_pan_max"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:inputType="numberSigned" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_tilt_limits" />

            <EditText
                android:id="@+id/set_tilt_min"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:inputType="numberSigned" />

            <EditText
                android:id="@+id/set_tilt_max"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:inputType="numberSigned" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                style="@style/FieldLabelCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_angular_scale" />

            <EditText
                android:id="@+id/set_scale"
                style="@style/EditFieldCompact"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:layout_marginStart="8dp"
                android:inputType="numberDecimal" />
        </LinearLayout>
    </LinearLayout>

    <!-- Данные -->
    <LinearLayout
        style="@style/CardCompact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            style="@style/FieldLabelCompact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_data" />

        <Button
            android:id="@+id/set_clear"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/settings_clear_action"
            android:textColor="?attr/pl_warn"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/set_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="?attr/pl_text_dim"
        android:textSize="11sp" />

</LinearLayout>
</ScrollView>
