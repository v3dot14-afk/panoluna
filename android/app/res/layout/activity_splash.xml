<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:background="?attr/pl_background">

    <!-- Luna Ultra перед сферической стеной из панорамных фотографий -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:src="@drawable/splash_panorama"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_splash_hero"
        android:clipToOutline="true"
        android:contentDescription="@string/splash_hero_description" />

    <!-- Название приложения -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginBottom="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="?attr/pl_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/splash_subtitle"
            android:textColor="?attr/pl_text_dim"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Состояние -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/splash_status_idle"
        android:textColor="?attr/pl_text_dim"
        android:textSize="14sp"
        android:layout_marginBottom="10dp"
        tools:ignore="HardcodedText" />

    <!-- Кнопка подключения -->
    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/splash_connect"
        android:textColor="?attr/pl_background"
        android:textSize="16sp"
        android:background="@drawable/bg_button_accent"
        android:elevation="2dp" />

    <!-- Кнопка настроек -->
    <Button
        android:id="@+id/btnSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/splash_settings"
        android:textColor="?attr/pl_text"
        android:textSize="15sp"
        android:background="@drawable/bg_button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/splash_hint"
        android:textColor="?attr/pl_text_dim"
        android:textSize="12sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
