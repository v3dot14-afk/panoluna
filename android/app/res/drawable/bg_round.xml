<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pl_surface_high" />
            <stroke android:width="2dp" android:color="?attr/pl_accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="?attr/pl_surface_high" />
            <stroke android:width="2dp" android:color="?attr/pl_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/pl_surface" />
            <stroke android:width="1dp" android:color="?attr/pl_line" />
        </shape>
    </item>
</selector>
