<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      ТЕМЫ. Каждая тема содержит ПОЛНУЮ палитру в собственных атрибутах pl_*.
      Это принципиально: раньше обе темы ссылались на одни и те же @color/*,
      а те переключались только системным ночным режимом через values-night.
      Приложение не могло сменить их само — setApplicationNightMode есть лишь
      с Android 12 (API 31) при minSdk 24, поэтому вызов тихо падал и светлая
      тема не включалась.

      Теперь цвета живут в теме. setTheme() до super.onCreate меняет всё
      оформление сразу и на любой версии Android.
    -->

    <!-- Тёмная тема (по умолчанию). -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="pl_background">#121417</item>
        <item name="pl_surface">#1D2024</item>
        <item name="pl_surface_high">#2A2E33</item>
        <item name="pl_text">#ECEFF1</item>
        <item name="pl_text_dim">#9AA0A6</item>
        <item name="pl_accent">#FFB300</item>
        <item name="pl_accent_dark">#C79100</item>
        <item name="pl_ok">#43A047</item>
        <item name="pl_warn">#E53935</item>
        <item name="pl_line">#3A3F45</item>
        <item name="pl_window_light_status_bar">false</item>

        <item name="android:windowBackground">?attr/pl_background</item>
        <item name="android:statusBarColor">?attr/pl_background</item>
        <item name="android:navigationBarColor">?attr/pl_background</item>
        <item name="android:textColorPrimary">?attr/pl_text</item>
        <item name="android:textColorSecondary">?attr/pl_text_dim</item>
        <item name="android:colorAccent">?attr/pl_accent</item>
        <item name="android:colorPrimary">?attr/pl_surface</item>
        <item name="android:colorPrimaryDark">?attr/pl_background</item>
        <item name="android:windowLightStatusBar">?attr/pl_window_light_status_bar</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Светлая тема: своя палитра целиком, независимо от values-night. -->
    <style name="AppTheme_Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="pl_background">#F2F3F5</item>
        <item name="pl_surface">#FFFFFF</item>
        <item name="pl_surface_high">#E9ECEF</item>
        <item name="pl_text">#1B1F24</item>
        <item name="pl_text_dim">#6B7280</item>
        <item name="pl_accent">#F59E0B</item>
        <item name="pl_accent_dark">#B45309</item>
        <item name="pl_ok">#16A34A</item>
        <item name="pl_warn">#DC2626</item>
        <item name="pl_line">#E2E5EA</item>
        <item name="pl_window_light_status_bar">true</item>

        <item name="android:windowBackground">?attr/pl_background</item>
        <item name="android:statusBarColor">?attr/pl_background</item>
        <item name="android:navigationBarColor">?attr/pl_background</item>
        <item name="android:textColorPrimary">?attr/pl_text</item>
        <item name="android:textColorSecondary">?attr/pl_text_dim</item>
        <item name="android:colorAccent">?attr/pl_accent</item>
        <item name="android:colorPrimary">?attr/pl_surface</item>
        <item name="android:colorPrimaryDark">?attr/pl_background</item>
        <item name="android:windowLightStatusBar">?attr/pl_window_light_status_bar</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Тема заставки: палитра нужна, чтобы цвета не зависели от системного режима. -->
    <style name="AppTheme.Splash" parent="AppTheme" />

    <style name="AppTheme.Transparent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Пульт прямоугольный с пиктограммой: без текста, только значок. -->
    <style name="RoundButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">12dp</item>
        <item name="android:tint">?attr/pl_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="RoundButton.Big">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="RoundButton.Small">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">9dp</item>
    </style>

    <style name="RoundButton.Accent">
        <item name="android:background">@drawable/bg_button_accent</item>
        <item name="android:tint">?attr/pl_background</item>
    </style>

    <style name="BottomButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">14dp</item>
        <item name="android:tint">?attr/pl_text</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/pl_text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SwitchRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="SwitchLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">?attr/pl_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Компактные стили для панели настроек: плотно, без лишнего пространства. -->
    <style name="CardCompact">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="GroupTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/pl_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="FieldLabelCompact">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/pl_text_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">0dp</item>
    </style>

    <style name="EditFieldCompact">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">?attr/pl_text</item>
        <item name="android:textColorHint">?attr/pl_text_dim</item>
        <item name="android:textSize">14sp</item>
        <item name="android:inputType">text</item>
    </style>

    <style name="LimitCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
    </style>

</resources>
