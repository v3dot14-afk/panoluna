<?xml version="1.0" encoding="utf-8"?>
<!-- Файл проекта Pano2VR — PanoLuna для Insta360 Luna Ultra -->
<!--
  Порядок обработки: 24 кадра -> PTGui (PanoLuna_24.pts) -> равнопромежуточная панорама 2:1
  Проект уже настроен на равнопромежуточную панораму: откройте его в Pano2VR и
  запустите сборку панорамы. Для выравнивания отдельных снимков используйте
  XML Papywizard (меню File > Import Papywizard в Pano2VR Pro).
-->
<pano2vrconfig>
  <panorama>
    <input>
      <patch/>
      <filename>PanoLuna_24shots_equirectangular.jpg</filename>
      <type>auto</type>
      <hfov>360</hfov>
    </input>
    <viewingparameter>
      <pan>0</pan>
      <tilt>0</tilt>
      <fov>75</fov>
    </viewingparameter>
    <userdata>
      <title>PanoLuna PanoLuna_24shots_equirectangular.jpg</title>
      <description>24 кадра Insta360 Luna Ultra, выровненные в PTGui</description>
    </userdata>
    <hotspots/>
    <output>
      <html>
        <enabled>1</enabled>
        <filename>output/PanoLuna_out.html</filename>
        <template>normal.ggt</template>
        <values>
          <value id="bgcolor">#000000</value>
          <value id="showuserdata">true</value>
        </values>
      </html>
      <flash>
        <enabled>0</enabled>
      </flash>
      <qtvr>
        <enabled>0</enabled>
      </qtvr>
      <transformations>
        <transformation>
          <type>equirectangular</type>
          <filename>output/$(n)_$(s).jpg</filename>
          <quality>95</quality>
          <width>27654</width>
          <height>13827</height>
          <tilewidth>512</tilewidth>
          <tileheight>512</tileheight>
          <multires>1</multires>
          <format>jpg</format>
        </transformation>
      </transformations>
    </output>
    <sounds/>
  </panorama>
</pano2vrconfig>
